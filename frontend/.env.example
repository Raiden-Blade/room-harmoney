# frontend ローカル環境変数の雛形（Vite は frontend/ 直下の .env* のみを読む）。
# 使う場合は `frontend/.env` にコピーする。API URLは未設定時も開発用既定値へ
# フォールバックし、外部チャットボットURLは未設定時に「接続準備中」の非リンク表示になる。

# バックエンドAPIのベースURL（リポジトリルート .env.example の VITE_API_BASE_URL と同じ役割）
VITE_API_BASE_URL=http://localhost:8000

# 既存チャットボットの連携先URL（control群／将来の外部相互リンク先）。
# 商品ページ内のガイド型チャットは VITE_API_BASE_URL の `/api/chat/turn` を使うため、
# この値や外部AIのAPIキーを必要としない。正式な接続先が提供されるまで空欄にする。
VITE_CHATBOT_BASE_URL=
