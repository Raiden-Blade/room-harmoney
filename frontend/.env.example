# frontend ローカル環境変数の雛形（Vite は frontend/ 直下の .env* のみを読む）。
# 使う場合は `frontend/.env` にコピーする。無くても以下の既定値にフォールバックする
# （src/api/client.ts, src/components/ChatbotLink.tsx）ため、開発は本ファイルが無くても動作する。

# バックエンドAPIのベースURL（リポジトリルート .env.example の VITE_API_BASE_URL と同じ役割）
VITE_API_BASE_URL=http://localhost:8000

# 既存チャットボットの連携先URL（4.4章 / S5 相互リンク先）
VITE_CHATBOT_BASE_URL=https://example.invalid/chatbot
