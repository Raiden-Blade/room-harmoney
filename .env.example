# Room Harmony 環境変数の雛形（16章 リポジトリ構成）
# 実際の値は .env にコピーして設定する。秘匿値はこのファイルに直書きしない。

# --- DB接続（開発は SQLite） ---
# 開発用は SQLite ファイルパス。本番は PostgreSQL 接続文字列に差し替え可能。
DATABASE_URL=sqlite:///./data/room_harmony.db

# --- 既存チャットボット連携先 ---
# 相互リンク／ディープリンク受け口（?product_id= / ?coordinate_id= 等）で連携する既存チャットボットのURL。
CHATBOT_BASE_URL=https://example.invalid/chatbot

# --- 店舗ID ---
# 対象店舗（DECISIONS.md #4: 目黒通り店をベースにした4フロア構成）を識別するID。
STORE_ID=meguro-dori

# --- 実験群割付（A/Bテスト） ---
# Room Harmony 利用群 / 非利用群の割付方式・比率設定。
EXPERIMENT_GROUP_MODE=random
EXPERIMENT_GROUP_RATIO=0.5

# --- CORS（フロント開発用） ---
FRONTEND_ORIGIN=http://localhost:5173

# --- CORS許可オリジン（カンマ区切り、複数指定可） ---
# `backend/app/main.py` の CORSMiddleware がここから読む。既定値には
# Vite dev サーバ（5173）と `vite preview` の本番ビルド配信（4173）を
# localhost/127.0.0.1 の両方で含める。本番環境では実際のオリジンに絞り込むこと。
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- バックエンドAPIのベースURL（フロントから参照） ---
VITE_API_BASE_URL=http://localhost:8000

# --- 管理系API認証（17章「管理系（データ投入・ダッシュボード）は認証必須」） ---
# `GET /api/admin/kpi` 等の管理系エンドポイントは `X-Admin-Token` ヘッダーがこの値と
# 一致しないと401を返す。開発用の既定値は必ず本番前に変更すること。
ADMIN_API_TOKEN=dev-admin-token-change-me

# --- 来店判定の高度化（フェーズ3-B / DECISIONS.md #7） ---
# 既定は "qr"（有効なQR起点セッションのみで来店とみなす＝従来と完全に同一挙動）。
# "qr+geofence" / "qr+wifi" / "qr+geofence+wifi" のように "+" 区切りで、QR検証に加えた
# 追加検証（AND合成）をオプトインできる（`backend/app/visit.py` 参照）。
VISIT_VERIFICATION_MODE=qr

# ジオフェンス（VISIT_VERIFICATION_MODE に geofence を含む場合のみ使用）。
# 既定値は目黒通り店（DECISIONS.md #4 のベース店舗）付近の妥当なダミー座標・半径(m)。
# 本番導入時は実店舗の測量値に置き換えること。
STORE_GEOFENCE_LAT=35.6203
STORE_GEOFENCE_LNG=139.6883
STORE_GEOFENCE_RADIUS_M=150

# 許可Wi-Fi SSID（カンマ区切り、複数可。VISIT_VERIFICATION_MODE に wifi を含む場合のみ使用）。
STORE_WIFI_SSIDS=Nitori-Free-Wifi,Nitori-Guest-Wifi
